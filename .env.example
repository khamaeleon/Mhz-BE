# 복사해서 .env 로 만들고 값을 채운다 (.env 는 커밋하지 않는다)

# DB 서버(EC2-AdPilot-DB)의 사설 IP로 접속. 비밀번호는 \password mhz_app 으로 정한 값
DATABASE_URL=postgres://mhz_app:비밀번호@172.31.39.16:5432/mhz

# 호스트에서 API 컨테이너에 접속할 포트 (ALB 대상 그룹 또는 nginx proxy_pass 대상). 다른 서비스와 겹치면 바꾼다
MHZ_PORT=4100

# API 포트를 열 주소. 같은 서버 nginx 만 쓰면 127.0.0.1(기본),
# AWS ALB(mhz.api.adpilot.co.kr)가 이 서버로 직접 보낼 때는 0.0.0.0 (보안 그룹에서 ALB 만 허용)
MHZ_BIND=127.0.0.1

# 도커 없이 로컬에서 npm start 로 띄울 때만 쓰는 값 (docker-compose 에서는 무시됨)
HOST=127.0.0.1
PORT=4100
