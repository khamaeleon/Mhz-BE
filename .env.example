# 복사해서 .env 로 만들고 값을 채운다 (.env 는 커밋하지 않는다)

# DB 서버(EC2-AdPilot-DB)의 사설 IP로 접속. 비밀번호는 \password mhz_app 으로 정한 값
DATABASE_URL=postgres://mhz_app:비밀번호@172.31.39.16:5432/mhz

# 호스트에서 API 컨테이너에 접속할 포트 (nginx proxy_pass 대상). 다른 서비스와 겹치면 바꾼다
MHZ_PORT=4100

# 도커 없이 로컬에서 npm start 로 띄울 때만 쓰는 값 (docker-compose 에서는 무시됨)
HOST=127.0.0.1
PORT=4100
